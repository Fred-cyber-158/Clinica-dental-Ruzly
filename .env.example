# Plantilla de variables de entorno (NO incluir contraseñas reales aquí)
DATABASE_URL="postgresql://usuario:password@localhost:5432/clinica_dental_ruzly?schema=public"

# Secreto de firma de sesiones. Debe tener 32 caracteres o más.
# Genérelo con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="cambie_este_valor_por_uno_aleatorio_de_32_o_mas_caracteres"

# URL pública del sistema (para los enlaces de recuperación de contraseña).
# En local puede quedar vacía y se usa el origen de la petición.
APP_URL="http://localhost:3000"

# Correo SMTP (Gmail + contraseña de aplicación) para recuperación de contraseña.
SMTP_USER=""
SMTP_PASS=""

# Credenciales iniciales del administrador (solo para el primer arranque).
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASSWORD="Ruzly2026"
