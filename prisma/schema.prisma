generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                  String    @id @default(cuid())
  username            String    @unique
  password            String
  nombre              String
  email               String?   @unique
  rol                 Rol       @default(PACIENTE)
  activo              Boolean   @default(false)
  pacienteId          String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  pendienteAprobacion Boolean   @default(true)
  paciente            Paciente? @relation(fields: [pacienteId], references: [id])
}

model Paciente {
  id           String        @id @default(cuid())
  nombre       String
  edad         Int?
  telefono     String?
  email        String?
  ci           String?       @unique
  alergias     String?
  activo       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  citas        Cita[]
  cobros       Cobro[]
  fotos        FotoClinica[]
  odontogramas Odontograma[]
  recetas      Receta[]
  tratamientos Tratamiento[]
  usuario      Usuario?
}

model Cita {
  id         String   @id @default(cuid())
  fecha      String
  hora       String
  motivo     String?
  estado     String   @default("PENDIENTE")
  pacienteId String
  createdAt  DateTime @default(now())
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
}

model Tratamiento {
  id          String    @id @default(cuid())
  nombre      String
  descripcion String?
  costo       Float
  pagado      Float     @default(0.0)
  activo      Boolean   @default(true)
  pacienteId  String?
  createdAt   DateTime  @default(now())
  paciente    Paciente? @relation(fields: [pacienteId], references: [id])
}

model Receta {
  id             String    @id @default(cuid())
  pacienteId     String?
  pacienteNombre String?
  medicamento    String
  indicaciones   String
  emitidaPor     String?
  createdAt      DateTime  @default(now())
  paciente       Paciente? @relation(fields: [pacienteId], references: [id])
}

model FotoClinica {
  id          String    @id @default(cuid())
  url         String
  descripcion String?
  pacienteId  String?
  createdAt   DateTime  @default(now())
  paciente    Paciente? @relation(fields: [pacienteId], references: [id])
}

model Cobro {
  id             String    @id @default(cuid())
  pacienteNombre String
  montoTotal     Float
  montoPagado    Float
  saldo          Float
  metodo         String    @default("EFECTIVO")
  pacienteId     String?
  createdAt      DateTime  @default(now())
  paciente       Paciente? @relation(fields: [pacienteId], references: [id])
}

model Odontograma {
  id          String   @id @default(cuid())
  pieza       String
  hallazgo    String
  estado      String   @default("DIAGNÓSTICO")
  observacion String?
  pacienteId  String
  createdAt   DateTime @default(now())
  paciente    Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
}

enum Rol {
  ADMINISTRADOR
  ODONTOLOGO
  RECEPCIONISTA
  PACIENTE
}
