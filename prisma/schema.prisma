datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Rol {
  ADMINISTRADOR
  ODONTOLOGO
  RECEPCIONISTA
  PACIENTE
}

model Usuario {
  id         String    @id @default(cuid())
  username   String    @unique
  password   String
  nombre     String
  email      String?   @unique
  rol        Rol       @default(PACIENTE)
  activo     Boolean   @default(true)
  pacienteId String?   @unique
  paciente   Paciente? @relation(fields: [pacienteId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Paciente {
  id           String        @id @default(cuid())
  nombre       String
  edad         Int?
  telefono     String?
  email        String?
  ci           String?       @unique
  alergias     String?
  activo       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  usuario      Usuario?
  citas        Cita[]
  tratamientos Tratamiento[]
  recetas      Receta[]
  fotos        FotoClinica[]
  cobros       Cobro[]
  odontogramas Odontograma[]
}

model Cita {
  id         String   @id @default(cuid())
  fecha      String
  hora       String
  motivo     String?
  estado     String   @default("PENDIENTE")
  pacienteId String
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Tratamiento {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  costo       Float
  pagado      Float    @default(0.0)
  activo      Boolean  @default(true)
  pacienteId  String?
  paciente    Paciente? @relation(fields: [pacienteId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model Receta {
  id             String    @id @default(cuid())
  pacienteId     String?
  pacienteNombre String?
  medicamento    String
  indicaciones   String
  createdAt      DateTime  @default(now())
  paciente       Paciente? @relation(fields: [pacienteId], references: [id])
}

model FotoClinica {
  id          String    @id @default(cuid())
  url         String
  descripcion String?
  pacienteId  String?
  paciente    Paciente? @relation(fields: [pacienteId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

model Cobro {
  id             String    @id @default(cuid())
  pacienteNombre String
  montoTotal     Float
  montoPagado    Float
  saldo          Float
  metodo         String    @default("EFECTIVO")
  pacienteId     String?
  paciente       Paciente? @relation(fields: [pacienteId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
}

model Odontograma {
  id          String   @id @default(cuid())
  pieza       String
  hallazgo    String
  estado      String   @default("DIAGNÓSTICO")
  observacion String?
  pacienteId  String
  paciente    Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}